# AI:X | 0RWX AI MADE | https://0rwx.com
# CH Manager Pro: Docker Compose settings.
# Copy to .env (cp .env.example .env), edit, then: docker compose up -d --build
# Every setting is optional; the values shown are the defaults.

# ---------------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------------

# Interface the port is published on. 0.0.0.0 = reachable from your network.
# Use 127.0.0.1 to allow only this machine (SSH tunnel or a proxy on the host).
CH_WEB_BIND=0.0.0.0

# Port on the host. The app always listens on 8899 inside the container.
CH_WEB_HOST_PORT=8899

# Hostnames browsers may use to reach the app, comma-separated.
# * accepts any hostname or IP (e.g. http://192.168.1.50:8899).
# A list such as chmanager.lan,192.168.1.50 is stricter: other names get "Host not allowed".
# The access token is required either way.
CH_WEB_ALLOWED_HOSTS=*

# Reverse proxies to trust, as IPs or CIDR ranges, comma-separated.
# Requests that arrive from these addresses are accepted for any client IP and
# any hostname behind them. The app also uses their X-Forwarded-For (client IP,
# for sign-in rate limiting), X-Forwarded-Host and X-Forwarded-Proto headers.
# Those headers are ignored from every other address, so they can't be faked.
# The address to list is the one the app sees the proxy connect from:
#   - proxy container on a Docker network:  172.16.0.0/12 (Docker's default ranges)
#   - proxy on another machine:             its LAN IP, e.g. 192.168.1.20
#   - proxy on this host, published port:   the Docker bridge gateway, e.g. 172.17.0.1
# Only list addresses that nothing but your proxy connects from: anything listed
# here can claim any client IP.
# Leave empty if you don't use a reverse proxy.
CH_WEB_TRUSTED_PROXIES=

# Mark the sign-in cookie HTTPS-only. Set true when browsers reach the app over
# HTTPS. Not needed if the trusted proxy sends X-Forwarded-Proto: https.
CH_WEB_SECURE_COOKIE=false

# ---------------------------------------------------------------------------
# Access
# ---------------------------------------------------------------------------

# Sign-in token, at least 24 characters. Leave empty to have one generated on
# first start; read it with: docker compose exec ch-manager cat /data/access-token
CH_WEB_TOKEN=

# Largest archive accepted per upload, in MiB. Your proxy's upload limit must allow it too.
CH_WEB_MAX_UPLOAD_MIB=2048

# ---------------------------------------------------------------------------
# Library folders
# ---------------------------------------------------------------------------
# Leave empty to keep each in a Docker named volume, or set a host path to use a
# real folder. Host folders must be writable by UID 1000. Inside the container
# they are /songs, /archives and /downloads; on first start the app uses those,
# and you can change them later in Settings.

# Songs Clone Hero plays from (share this folder with your gaming PC/Steam Deck).
CH_SONGS_DIR=
# Original downloaded packs, kept so you can install songs from them later.
CH_ARCHIVES_DIR=
# Watch folder: completed downloads placed here are imported automatically.
CH_DOWNLOADS_DIR=
